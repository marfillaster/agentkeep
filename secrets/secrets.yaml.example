# Example of the SHARED secrets file's plaintext shape.
#
# The real file is secrets/secrets.yaml — created and edited ONLY via
# `scripts/secret-edit`, which opens it in SOPS and re-encrypts on save. Do NOT
# create secrets.yaml by hand, and never commit a plaintext copy (.gitignore guards
# *.plaintext / *.decrypted / *.env).
#
# Convention: each key IS the environment variable name it populates (key == $VAR).
# Read one with `scripts/secret-get EXAMPLE_API_TOKEN` — but if $EXAMPLE_API_TOKEN
# is already exported, prefer that and skip decryption (see context/secrets.md).
#
# Values are flat strings. Group with dotted keys if you like (yq dotted-path read):
#
#   EXAMPLE_API_TOKEN: "replace-with-your-token"
#   ANOTHER_SERVICE_KEY: "..."

EXAMPLE_API_TOKEN: "your-secret-value-here"
