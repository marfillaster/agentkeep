#!/usr/bin/env bash
# Open an encrypted secrets file in your editor via SOPS.
# SOPS decrypts to a temp file, opens $EDITOR, then re-encrypts on save.
#
#   scripts/secret-edit                # shared secrets (all identities)
#   scripts/secret-edit --machine      # this machine's private bundle
#   scripts/secret-edit --key          # alias for --machine
#
# The bundle (secrets/machines/<slug>.yaml) is encrypted to the SET of identities
# this machine opted into (its .sops.yaml rule) — read by whichever device is
# present. The identities are resolved by scripts/lib/age-env.sh from .machine.env.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
target="$repo_root/secrets/secrets.yaml"

case "${1:-}" in
  --machine|--key)
    mkdir -p "$repo_root/secrets/machines"
    target="$repo_root/secrets/machines/$("$repo_root/scripts/machine-id").yaml" ;;
  "") ;;
  *) echo "usage: secret-edit [--machine|--key]" >&2; exit 2 ;;
esac

# shellcheck source=lib/age-env.sh
. "$repo_root/scripts/lib/age-env.sh"
ac_load_config
ac_prepare_age_env

sops "$target"
