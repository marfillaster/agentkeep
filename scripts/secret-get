#!/usr/bin/env bash
# Decrypt the secrets and print a single value by dotted key path.
#
#   scripts/secret-get EXAMPLE_API_TOKEN
#   scripts/secret-get EXAMPLE_API_TOKEN --identity yubikey-5c
#
# Looks in this machine's bundle first (secrets/machines/<slug>.yaml, if present
# and decryptable), then the shared file (secrets/secrets.yaml). So a bundle value
# overrides a shared one of the same name.
#
# --identity NAME (alias --key) forces decryption with ONLY that identity (from
# identities.yaml) instead of this machine's full AGE_IDENTITIES set, and bypasses
# the session cache — handy to verify a specific key (e.g. a YubiKey) actually
# decrypts. The identity's backend is resolved by scripts/lib/age-env.sh.
#
# Prints ONLY the requested value to stdout. Never echo the result into logs,
# commit messages, or commands that get recorded.
set -euo pipefail

key=""; force_id=""
while [ $# -gt 0 ]; do
  case "$1" in
    --identity|--key) force_id="${2:-}"; shift 2 ;;
    -h|--help) echo "usage: secret-get <KEY> [--identity NAME]" >&2; exit 0 ;;
    -*) echo "secret-get: unknown option: $1" >&2; exit 2 ;;
    *) if [ -z "$key" ]; then key="$1"; else echo "secret-get: unexpected arg: $1" >&2; exit 2; fi; shift ;;
  esac
done
if [ -z "$key" ]; then
  echo "usage: secret-get <KEY> [--identity NAME]   e.g. EXAMPLE_API_TOKEN" >&2
  exit 2
fi

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/age-env.sh
. "$repo_root/scripts/lib/age-env.sh"
ac_load_config
# Force a single identity (overrides .machine.env) and skip the cache so the
# chosen backend is actually exercised.
if [ -n "$force_id" ]; then
  # consumed by the sourced lib (ac_prepare_age_env / ac_cache_enabled)
  # shellcheck disable=SC2034
  AGE_IDENTITIES="$force_id"
  # shellcheck disable=SC2034
  AGE_CACHE=0
fi

shared_file="$repo_root/secrets/secrets.yaml"
machine_file="$repo_root/secrets/machines/$("$repo_root/scripts/machine-id").yaml"

# Print the value for $key from a single secrets file, or return non-zero if the
# file is absent, can't be decrypted, or doesn't contain the key.
get_from() {
  local file="$1" decrypted value
  decrypted="$(ac_decrypt_file "$file")" || return 1
  value="$(printf '%s\n' "$decrypted" | yq -e ".${key}" 2>/dev/null)" || return 1
  [ -n "$value" ] && [ "$value" != "null" ] || return 1
  printf '%s\n' "$value"
}

# Machine-specific value wins, then fall back to shared.
if get_from "$machine_file"; then
  exit 0
fi
if get_from "$shared_file"; then
  exit 0
fi

echo "secret-get: key not found: ${key}" >&2
exit 1
