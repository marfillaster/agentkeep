#!/usr/bin/env bash
# Re-encrypt secrets to match the current recipient list in .sops.yaml.
# Run this after adding or removing a recipient (machine) in .sops.yaml.
#
# Rekeys only the files THIS machine can decrypt: the shared file plus this
# machine's own isolated file (if it exists). Each other machine rekeys its own
# isolated file, since no one else can decrypt it.
#
# The key store is resolved by scripts/lib/age-env.sh from .machine.env.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/age-env.sh
. "$repo_root/scripts/lib/age-env.sh"
ac_load_config
ac_prepare_age_env

files=("$repo_root/secrets/secrets.yaml")
machine_file="$repo_root/secrets/machines/$("$repo_root/scripts/machine-id").yaml"
[ -f "$machine_file" ] && files+=("$machine_file")

for file in "${files[@]}"; do
  echo "rekeying: ${file#"$repo_root"/}" >&2
  sops updatekeys "$file"
done
